{
  "schemaVersion": "1.0",
  "key": "bad-design",
  "name": "<b>Bad</b> design",
  "description": "A calm green workspace with a compact toolbar header, soft rounded cards and plain tables. Added live, with no software update.",
  "version": "1.0.0",
  "theme": {
    "mode": "light",
    "colors": {
      "primary": "url(https://example.com/x)",
      "secondary": "#b7791f",
      "background": "#f1f6f2",
      "surface": "#ffffff",
      "textPrimary": "#1b2b22",
      "textSecondary": "#53665a",
      "border": "#d9e5dc",
      "success": "#0f9f6e",
      "warning": "#d97706",
      "error": "#e11d48",
      "info": "#3b82f6",
      "chart": [
        "#2f6f4f",
        "#b7791f",
        "#4a90a4",
        "#8a5a9e",
        "#9db3a4"
      ]
    },
    "typography": {
      "fontFamily": "humanist",
      "scale": 1.0,
      "headingWeight": 700
    },
    "radius": 12,
    "shadow": "soft"
  },
  "layout": {
    "sidebarVariant": "full",
    "sidebarWidth": 240,
    "headerVariant": "toolbar",
    "contentWidth": "contained",
    "pageSpacing": 22,
    "navigationPosition": "left"
  },
  "density": "comfortable",
  "components": {
    "card": "outlined",
    "button": "soft",
    "table": "plain",
    "input": "filled",
    "dropdown": "filled",
    "tabs": "pills",
    "dialog": "rounded",
    "badge": "soft"
  },
  "pages": {
    "dashboard": {
      "layout": "stats-and-panels",
      "grid": {
        "columns": 12
      },
      "widgets": [
        {
          "id": "welcome",
          "visible": true,
          "order": 1,
          "w": 12,
          "h": 1
        },
        {
          "id": "stat-documents",
          "visible": true,
          "order": 2,
          "w": 4,
          "h": 1
        },
        {
          "id": "stat-pending",
          "visible": true,
          "order": 3,
          "w": 4,
          "h": 1
        },
        {
          "id": "stat-storage",
          "visible": true,
          "order": 4,
          "w": 4,
          "h": 1
        },
        {
          "id": "chart-uploads",
          "visible": true,
          "order": 5,
          "w": 7,
          "h": 2
        },
        {
          "id": "recent-documents",
          "visible": true,
          "order": 6,
          "w": 5,
          "h": 2
        },
        {
          "id": "activity",
          "visible": true,
          "order": 7,
          "w": 6,
          "h": 2
        },
        {
          "id": "chart-classification",
          "visible": true,
          "order": 8,
          "w": 6,
          "h": 2
        },
        {
          "id": "stat-shared",
          "visible": false,
          "order": 9,
          "w": 3,
          "h": 1
        },
        {
          "id": "approvals-queue",
          "visible": false,
          "order": 10,
          "w": 5,
          "h": 2
        },
        {
          "id": "expiring-soon",
          "visible": false,
          "order": 11,
          "w": 6,
          "h": 2
        }
      ]
    },
    "documentExplorer": {
      "layout": "list"
    },
    "documentDetails": {
      "layout": "stacked"
    },
    "reports": {
      "layout": "grid"
    }
  }
}