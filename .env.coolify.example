# Names only: set the real values in Coolify's Environment Variables screen. Never commit values.
# --- required ---
POSTGRES_PASSWORD=
SECRET_KEY=
# The public address of the web app, for example https://dms.example.com (no trailing slash).
APP_BASE_URL=
API_BASE_URL=
# --- mode ---
# staging while email or the production bucket are not ready; production once they are.
ENVIRONMENT=production
# --- document storage (Backblaze B2; required in production) ---
STORAGE_PROVIDER=backblaze
DMS_B2_KEY_ID=
DMS_B2_APP_KEY=
DMS_B2_BUCKET_NAME=
# --- virus scanning (optional for the first release) ---
SCANNER_BACKEND=none
ALLOW_UNSCANNED_UPLOADS=true
# To turn scanning on later: SCANNER_BACKEND=clamav, ALLOW_UNSCANNED_UPLOADS=false, COMPOSE_PROFILES=scan
COMPOSE_PROFILES=
# --- email (Brevo, Zoho ZeptoMail and others all use these four values) ---
EMAIL_BACKEND=smtp
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# --- sign in with Google or Microsoft (optional; blank hides the buttons) ---
SSO_GOOGLE_CLIENT_ID=
SSO_MICROSOFT_CLIENT_ID=
# --- other ---
MFA_ENCRYPTION_KEY=
DMS_MAX_UPLOAD_BYTES=104857600
NGINX_MAX_BODY=110m
WEB_CONCURRENCY=1
