{
  "comment": "Shared by the TypeScript and Python tests. Each case sets one value (a dotted path) or removes it (remove: true) on a valid template; the result must be rejected. Array positions use numbers, for example pages.dashboard.widgets.0.w; a star sets every item; repeat builds a long string.",
  "cases": [
    { "name": "unknown top-level property", "path": "script", "value": "alert(1)" },
    { "name": "missing theme", "path": "theme", "remove": true },
    { "name": "wrong schema version", "path": "schemaVersion", "value": "2.0" },
    { "name": "key with capitals", "path": "key", "value": "Modern-Enterprise" },
    { "name": "key with spaces", "path": "key", "value": "my template" },
    { "name": "key too short", "path": "key", "value": "ab" },
    { "name": "html in name", "path": "name", "value": "<script>alert(1)</script>" },
    { "name": "html in description", "path": "description", "value": "nice <img src=x onerror=alert(1)>" },
    { "name": "empty name", "path": "name", "value": "" },
    { "name": "description too long", "path": "description", "repeat": { "char": "x", "times": 301 } },
    { "name": "version not semantic", "path": "version", "value": "1.0" },
    { "name": "preview image over http", "path": "previewImage", "value": "http://example.com/a.png" },
    { "name": "preview image as javascript url", "path": "previewImage", "value": "javascript:alert(1)" },
    { "name": "preview image as data url", "path": "previewImage", "value": "data:image/svg+xml;base64,PHN2Zz4=" },
    { "name": "color as css function", "path": "theme.colors.primary", "value": "url(https://evil.example/x)" },
    { "name": "color as short hex", "path": "theme.colors.primary", "value": "#fff" },
    { "name": "color with css injection", "path": "theme.colors.surface", "value": "#ffffff;background:url(x)" },
    { "name": "chart palette too short", "path": "theme.colors.chart", "value": ["#111111", "#222222"] },
    { "name": "font outside the allow-list", "path": "theme.typography.fontFamily", "value": "Comic Sans MS" },
    { "name": "font as css injection", "path": "theme.typography.fontFamily", "value": "x}body{display:none" },
    { "name": "scale too large", "path": "theme.typography.scale", "value": 3 },
    { "name": "heading weight not allowed", "path": "theme.typography.headingWeight", "value": 550 },
    { "name": "negative radius", "path": "theme.radius", "value": -1 },
    { "name": "radius not integer", "path": "theme.radius", "value": 4.5 },
    { "name": "unknown shadow", "path": "theme.shadow", "value": "0 0 99px red" },
    { "name": "unknown mode", "path": "theme.mode", "value": "sepia" },
    { "name": "unknown sidebar variant", "path": "layout.sidebarVariant", "value": "hidden" },
    { "name": "sidebar too wide", "path": "layout.sidebarWidth", "value": 900 },
    { "name": "page spacing too small", "path": "layout.pageSpacing", "value": 0 },
    { "name": "unknown density", "path": "density", "value": "tiny" },
    { "name": "unknown card variant", "path": "components.card", "value": "neon" },
    { "name": "unknown button variant", "path": "components.button", "value": "<b>x</b>" },
    { "name": "extra component", "path": "components.carousel", "value": "fancy" },
    { "name": "unknown dashboard layout", "path": "pages.dashboard.layout", "value": "custom" },
    { "name": "unsupported grid columns", "path": "pages.dashboard.grid.columns", "value": 5 },
    { "name": "unknown widget id", "path": "pages.dashboard.widgets.0.id", "value": "my-widget" },
    { "name": "widget too wide", "path": "pages.dashboard.widgets.0.w", "value": 13 },
    { "name": "widget height zero", "path": "pages.dashboard.widgets.0.h", "value": 0 },
    { "name": "widget visible as string", "path": "pages.dashboard.widgets.0.visible", "value": "yes" },
    { "name": "widget with extra property", "path": "pages.dashboard.widgets.0.html", "value": "<b>x</b>" },
    { "name": "no widgets", "path": "pages.dashboard.widgets", "value": [] },
    { "name": "unknown explorer layout", "path": "pages.documentExplorer.layout", "value": "kanban" },
    { "name": "unknown details layout", "path": "pages.documentDetails.layout", "value": "wizard" },
    { "name": "unknown reports layout", "path": "pages.reports.layout", "value": "free" },
    { "name": "widget wider than the grid", "path": "pages.dashboard.grid.columns", "value": 6, "semantic": true },
    { "name": "duplicate widget id", "path": "pages.dashboard.widgets.1.id", "value": "stat-documents", "semantic": true },
    { "name": "every widget hidden", "path": "pages.dashboard.widgets.*.visible", "value": false, "semantic": true },
    { "name": "top sidebar with left navigation", "path": "layout.sidebarVariant", "value": "top", "semantic": true },
    { "name": "left sidebar with zero width", "path": "layout.sidebarWidth", "value": 0, "semantic": true }
  ]
}
