{
  "schemaVersion": "1.0",
  "key": "premium-dark",
  "name": "Premium Dark",
  "description": "Deep navy workspace with a gold accent, glass-style cards and a hero dashboard for long working sessions.",
  "version": "1.0.0",
  "theme": {
    "mode": "dark",
    "colors": {
      "primary": "#8aa4ff",
      "secondary": "#f2b84b",
      "background": "#0a1020",
      "surface": "#121a2f",
      "textPrimary": "#e8edf8",
      "textSecondary": "#93a0bd",
      "border": "#243153",
      "success": "#4ade80",
      "warning": "#fbbf24",
      "error": "#f87171",
      "info": "#60a5fa",
      "chart": [
        "#8aa4ff",
        "#f2b84b",
        "#34d399",
        "#f472b6",
        "#64748b"
      ]
    },
    "typography": {
      "fontFamily": "geometric",
      "scale": 1.0,
      "headingWeight": 600
    },
    "radius": 14,
    "shadow": "strong"
  },
  "layout": {
    "sidebarVariant": "full",
    "sidebarWidth": 232,
    "headerVariant": "minimal",
    "contentWidth": "contained",
    "pageSpacing": 28,
    "navigationPosition": "left"
  },
  "density": "comfortable",
  "components": {
    "card": "glass",
    "button": "soft",
    "table": "lined",
    "input": "filled",
    "dropdown": "filled",
    "tabs": "pills",
    "dialog": "rounded",
    "badge": "dot"
  },
  "pages": {
    "dashboard": {
      "layout": "dark-hero",
      "grid": {
        "columns": 12
      },
      "widgets": [
        {
          "id": "welcome",
          "visible": true,
          "order": 1,
          "w": 12,
          "h": 2
        },
        {
          "id": "stat-pending",
          "visible": true,
          "order": 2,
          "w": 4,
          "h": 1
        },
        {
          "id": "stat-documents",
          "visible": true,
          "order": 3,
          "w": 4,
          "h": 1
        },
        {
          "id": "stat-storage",
          "visible": true,
          "order": 4,
          "w": 4,
          "h": 1
        },
        {
          "id": "chart-uploads",
          "visible": true,
          "order": 5,
          "w": 8,
          "h": 2
        },
        {
          "id": "chart-classification",
          "visible": true,
          "order": 6,
          "w": 4,
          "h": 2
        },
        {
          "id": "approvals-queue",
          "visible": true,
          "order": 7,
          "w": 6,
          "h": 2
        },
        {
          "id": "expiring-soon",
          "visible": true,
          "order": 8,
          "w": 6,
          "h": 2
        },
        {
          "id": "stat-shared",
          "visible": false,
          "order": 9,
          "w": 3,
          "h": 1
        },
        {
          "id": "recent-documents",
          "visible": false,
          "order": 10,
          "w": 7,
          "h": 2
        },
        {
          "id": "activity",
          "visible": false,
          "order": 11,
          "w": 6,
          "h": 2
        }
      ]
    },
    "documentExplorer": {
      "layout": "table"
    },
    "documentDetails": {
      "layout": "tabbed"
    },
    "reports": {
      "layout": "grid"
    }
  }
}
