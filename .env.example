# Names only. Never commit real values. Backend-only; never prefix with VITE_/EXPO_PUBLIC_.
ENVIRONMENT=development
DATABASE_URL=<postgresql+psycopg://user:password@host:5432/dms>
SECRET_KEY=<REDACTED>
STORAGE_PROVIDER=<local|backblaze>
# Backblaze B2: DMS-specific bucket and key (not the ERP's). Names are provisional until Sprint 8/9 verifies them.
DMS_B2_KEY_ID=<REDACTED>
DMS_B2_APP_KEY=<REDACTED>
DMS_B2_BUCKET_NAME=<dms-bucket-name>
DMS_DOWNLOAD_URL_TTL_SECONDS=300
DMS_MAX_UPLOAD_BYTES=104857600
