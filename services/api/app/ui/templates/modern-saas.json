{
  "schemaVersion": "1.0",
  "key": "modern-saas",
  "name": "Modern SaaS",
  "description": "Contemporary indigo palette with a floating sidebar, gradient cards, pill buttons and soft shadows.",
  "version": "1.0.0",
  "theme": {
    "mode": "light",
    "colors": {
      "primary": "#5b5bd6",
      "secondary": "#14b8a6",
      "background": "#f2f1fb",
      "surface": "#ffffff",
      "textPrimary": "#1e1b3a",
      "textSecondary": "#615f82",
      "border": "#e4e2f5",
      "success": "#0f9f6e",
      "warning": "#d97706",
      "error": "#e11d48",
      "info": "#3b82f6",
      "chart": ["#5b5bd6", "#14b8a6", "#f59e0b", "#ec4899", "#a5a3d6"]
    },
    "typography": { "fontFamily": "system-sans", "scale": 1.0, "headingWeight": 700 },
    "radius": 18,
    "shadow": "medium"
  },
  "layout": {
    "sidebarVariant": "floating",
    "sidebarWidth": 244,
    "headerVariant": "pill",
    "contentWidth": "fluid",
    "pageSpacing": 24,
    "navigationPosition": "left"
  },
  "density": "comfortable",
  "components": {
    "card": "gradient",
    "button": "pill",
    "table": "plain",
    "input": "filled",
    "dropdown": "filled",
    "tabs": "segmented",
    "dialog": "rounded",
    "badge": "filled"
  },
  "pages": {
    "dashboard": {
      "layout": "stats-and-panels",
      "grid": { "columns": 12 },
      "widgets": [
        { "id": "welcome", "visible": true, "order": 1, "w": 12, "h": 1 },
        { "id": "stat-documents", "visible": true, "order": 2, "w": 4, "h": 1 },
        { "id": "stat-pending", "visible": true, "order": 3, "w": 4, "h": 1 },
        { "id": "stat-storage", "visible": true, "order": 4, "w": 4, "h": 1 },
        { "id": "chart-uploads", "visible": true, "order": 5, "w": 7, "h": 2 },
        { "id": "recent-documents", "visible": true, "order": 6, "w": 5, "h": 2 },
        { "id": "activity", "visible": true, "order": 7, "w": 6, "h": 2 },
        { "id": "chart-classification", "visible": true, "order": 8, "w": 6, "h": 2 },
        { "id": "stat-shared", "visible": false, "order": 9, "w": 3, "h": 1 },
        { "id": "approvals-queue", "visible": false, "order": 10, "w": 5, "h": 2 },
        { "id": "expiring-soon", "visible": false, "order": 11, "w": 6, "h": 2 }
      ]
    },
    "documentExplorer": { "layout": "grid" },
    "documentDetails": { "layout": "two-column" },
    "reports": { "layout": "grid" }
  }
}
